# ---------- LLM ----------
# 兼容 OpenAI 协议。留空则自动降级为 deterministic 模式（无 LLM 调用）。
# 三行必须配套：key 属于哪个平台，base_url 就必须是那个平台的，错配只会得到 401。
#
# 方案一：阿里云百炼（DashScope 兼容模式）
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=deepseek-v4.1-flash
#   LLM_API_KEY=sk-xxx        # 百炼控制台的 key；注意本项目不读 DASHSCOPE_API_KEY 这个变量名
#   业务空间专属域名（官方建议迁移）：
#     https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#
# 方案二：DeepSeek 官方
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
# 方案三：本地自训模型（A6 实测，见 README §14）
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=qwen25-1.5b-triple:q4km
#   LLM_API_KEY=ollama        # 本地端点不校验，但必须非空，否则被判为未启用而静默降级
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
# 思考模式。auto=仅在百炼端点下发 enable_thinking=False；on/off=强制。
# deepseek-v4.1-flash 默认思考，思维链与正文共享 max_tokens——本项目 answer 节点只给 480，
# 一开思考正文就被挤成空串（finish_reason=length），表现是「配了 key 仍回模板答案」。
LLM_THINKING=auto

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lexweave
NEO4J_DATABASE=neo4j

# ---------- 图后端 ----------
# auto: 能连上 Neo4j 就用 Neo4j，否则回落 NetworkX 离线镜像
# neo4j | networkx | auto
GRAPH_BACKEND=auto

# ---------- Embedding / Rerank ----------
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
ALIGN_MODEL_NAME=BAAI/bge-large-zh-v1.5
ALIGN_THRESHOLD=0.85

# ---------- 检索 ----------
TEXT_TOP_K=20
GRAPH_TOP_K=10
HYBRID_TOP_K=8
RRF_K=60

# ---------- 运行 ----------
SESSION_DB_PATH=data/sessions/sessions.sqlite3
CHECKPOINT_DIR=data/sessions/checkpoints
LOG_LEVEL=INFO
